#!/bin/sh
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mask=0
case " $(cat /proc/cmdline) " in *'pci=disable_acs_redir='*) mask=44;; *'pci=config_acs='*) mask=127;; esac
if insmod /modules/native_acs_probe.ko restore_test=1 expected_mask=$mask; then
 dmesg | grep 'NATIVE-ACS'
 echo 'ACS-TEST PASS'
else
 echo 'ACS-TEST FAIL'
 dmesg
fi
poweroff -f
